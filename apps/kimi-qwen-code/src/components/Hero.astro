---
import OrbitaSVG from './OrbitaSVG.astro';
---

<section class="hero" id="topo" aria-label="Apresentação do ÓRBITA">
  <!-- camadas de fundo com paralaxe -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow" data-depth="14"></div>
    <div class="hero__rings" data-depth="24">
      <span class="hero__ring hero__ring--1"></span>
      <span class="hero__ring hero__ring--2"></span>
      <span class="hero__ring hero__ring--3"></span>
    </div>
    <div class="hero__particles" data-depth="56">
      <i style="--x:12%; --y:22%; --t:9s;  --dl:0s"></i>
      <i style="--x:22%; --y:68%; --t:12s; --dl:-3s"></i>
      <i style="--x:48%; --y:14%; --t:10s; --dl:-6s"></i>
      <i style="--x:66%; --y:78%; --t:14s; --dl:-2s"></i>
      <i style="--x:82%; --y:30%; --t:11s; --dl:-8s"></i>
      <i style="--x:90%; --y:60%; --t:13s; --dl:-5s"></i>
      <i style="--x:38%; --y:84%; --t:10s; --dl:-4s"></i>
      <i style="--x:74%; --y:8%;  --t:12s; --dl:-7s"></i>
    </div>
  </div>

  <div class="wrap hero__in">
    <div class="hero__copy">
      <p class="kicker h-anim" style="--hd:120ms">Cancelamento de ruído adaptativo espacial</p>
      <h1 class="h-xl hero__title">
        <span class="line"><span style="--hd:280ms">O silêncio</span></span>
        <span class="line"><span style="--hd:400ms">entra em</span></span>
        <span class="line"><span class="accent" style="--hd:520ms">órbita.</span></span>
      </h1>
      <p class="lead h-anim" style="--hd:680ms">
        O ÓRBITA lê a acústica do ambiente 200 vezes por segundo e recalcula o
        anti-ruído como um satélite corrige trajetória. Você só ouve o que importa.
      </p>
      <div class="hero__ctas h-anim" style="--hd:820ms">
        <a class="btn" href="#configurador" data-ripple>Configurar o meu</a>
        <a class="btn btn--ghost" href="#tecnologia">Como funciona</a>
      </div>
      <ul class="hero__specs h-anim" role="list" style="--hd:980ms">
        <li><strong>40h</strong><span>bateria</span></li>
        <li><strong>−48dB</strong><span>ANC</span></li>
        <li><strong>BT 5.4</strong><span>multiponto</span></li>
        <li><strong>214g</strong><span>peso</span></li>
      </ul>
    </div>

    <div class="hero__stage">
      <div class="hero__product" data-depth="38">
        <OrbitaSVG uid="hero" class="hero__svg" />
      </div>
    </div>
  </div>

  <a class="hero__scroll h-anim" style="--hd:1300ms" href="#tecnologia" aria-label="Rolar para a seção de tecnologia">
    <span class="hero__scroll-track"><span class="hero__scroll-dot"></span></span>
    <span class="muted">role para explorar</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: 100px;
    overflow: clip;
  }

  /* ---- fundo ---- */
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .hero__bg > * { position: absolute; inset: 0; }

  .hero__glow {
    background:
      radial-gradient(42% 36% at 72% 42%, var(--glow), transparent 70%),
      radial-gradient(30% 26% at 18% 80%, var(--teal-soft), transparent 70%);
    animation: glow-breathe 7s var(--ease-io) infinite alternate;
  }
  @keyframes glow-breathe {
    from { opacity: 0.65; scale: 1; }
    to   { opacity: 1; scale: 1.06; }
  }

  .hero__rings { display: grid; place-items: center; }
  .hero__ring {
    position: absolute;
    border: 1px solid var(--line);
    border-radius: 50%;
    animation: ring-spin linear infinite;
  }
  .hero__ring::before {
    content: '';
    position: absolute;
    top: -3px; left: 50%;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 12px var(--teal);
  }
  .hero__ring--1 { width: 46vmin; height: 46vmin; animation-duration: 26s; }
  .hero__ring--2 { width: 68vmin; height: 68vmin; animation-duration: 44s; animation-direction: reverse; }
  .hero__ring--3 { width: 92vmin; height: 92vmin; animation-duration: 70s; border-style: dashed; opacity: 0.6; }
  @keyframes ring-spin { to { rotate: 360deg; } }

  .hero__particles i {
    position: absolute;
    left: var(--x); top: var(--y);
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.35;
    animation: particle-drift var(--t) var(--ease-io) var(--dl) infinite alternate;
  }
  @keyframes particle-drift {
    from { translate: 0 0; opacity: 0.18; }
    50%  { opacity: 0.5; }
    to   { translate: 14px -26px; opacity: 0.2; }
  }

  /* ---- conteúdo ---- */
  .hero__in {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--s6);
  }
  .hero__copy { display: grid; gap: var(--s5); justify-items: start; }

  .hero__title { display: grid; }
  .hero__title .line { display: block; overflow: clip; padding-block: 0.06em; }
  .hero__title .line > span {
    display: inline-block;
    clip-path: inset(0 0 110% 0);
    translate: 0 0.35em;
    animation: line-in var(--d4) var(--ease-expo) var(--hd, 0ms) forwards;
  }
  .hero__title .accent { color: var(--accent); }
  @keyframes line-in {
    to { clip-path: inset(-12% 0 -12% 0); translate: 0 0; }
  }

  .h-anim {
    opacity: 0;
    translate: 0 26px;
    animation: hero-rise var(--d3) var(--ease-expo) var(--hd, 0ms) forwards;
  }
  @keyframes hero-rise { to { opacity: 1; translate: 0 0; } }

  .hero__ctas { display: flex; gap: var(--s4); flex-wrap: wrap; }

  .hero__specs {
    display: flex;
    gap: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--line);
  }
  .hero__specs li { display: grid; }
  .hero__specs strong { font-family: var(--font-display); font-size: 1.05rem; }
  .hero__specs span { font-size: 0.78rem; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; }

  /* ---- produto ---- */
  .hero__stage { position: relative; display: grid; place-items: center; }
  .hero__product { width: min(100%, 420px); will-change: transform; }
  .hero__svg {
    animation:
      hero-product-in var(--d4) var(--ease-spring) 460ms backwards,
      hero-float 6s var(--ease-io) 1.8s infinite alternate;
  }
  @keyframes hero-product-in {
    from { opacity: 0; translate: 0 90px; scale: 0.82; rotate: -6deg; }
    to   { opacity: 1; translate: 0 0; scale: 1; rotate: 0deg; }
  }
  @keyframes hero-float {
    from { translate: 0 -8px; }
    to   { translate: 0 12px; }
  }
  .hero__svg .o-shadow { animation: shadow-pulse 6s var(--ease-io) 1.8s infinite alternate; transform-origin: 252px 448px; }
  @keyframes shadow-pulse {
    from { scale: 1.04; opacity: 0.32; }
    to   { scale: 0.92; opacity: 0.2; }
  }

  /* ---- indicador de scroll ---- */
  .hero__scroll {
    position: absolute;
    bottom: var(--s5);
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: var(--s2);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__scroll-track {
    width: 22px; height: 34px;
    border: 1.5px solid var(--muted);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .hero__scroll-dot {
    width: 4px; height: 8px;
    border-radius: 999px;
    background: var(--accent);
    animation: scroll-dot 1.8s var(--ease-io) infinite;
  }
  @keyframes scroll-dot {
    0%   { translate: 0 0; opacity: 1; }
    70%  { translate: 0 12px; opacity: 0; }
    100% { translate: 0 0; opacity: 0; }
  }

  @media (max-width: 900px) {
    .hero__in { grid-template-columns: 1fr; gap: var(--s7); padding-top: var(--s6); }
    .hero__copy { justify-items: center; text-align: center; }
    .hero__specs { gap: var(--s5); }
    .hero__product { width: min(74vw, 320px); }
    .hero__scroll { display: none; }
    .hero { min-height: auto; padding-bottom: var(--s8); }
  }
</style>

<script>
  import '../scripts/hero.js';
</script>
