---
// OrbitaSVG — representação autoral do fone ÓRBITA.
// Partes agrupadas com data-part para o explode do scroll-telling.
// Cores via CSS vars --cup / --cup-2 (configurador).
interface Props { uid?: string; class?: string; }
const { uid = 'a', class: cls = '' } = Astro.props;
---

<svg
  class={`orbita-svg ${cls}`}
  viewBox="0 0 440 480"
  role="img"
  aria-label="Fone de ouvido ÓRBITA"
  style="--cup:#23232e; --cup-2:#3a3a4a;"
>
  <defs>
    <linearGradient id={`sheen-${uid}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.22" />
      <stop offset="0.45" stop-color="#fff" stop-opacity="0.05" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id={`driver-${uid}`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="var(--teal)" stop-opacity="0.9" />
      <stop offset="0.55" stop-color="var(--teal)" stop-opacity="0.25" />
      <stop offset="1" stop-color="var(--teal)" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- sombra de chão -->
  <ellipse class="o-shadow" cx="252" cy="448" rx="118" ry="14" fill="#000" opacity="0.28" />

  <g class="o-cup-group">
    <!-- arco / headband -->
    <g class="o-part" data-part="band">
      <path
        d="M 168 352 C 112 128, 342 92, 282 238"
        fill="none" stroke="var(--cup)" stroke-width="26" stroke-linecap="round"
        style="transition: stroke var(--d3) var(--ease-io)"
      />
      <path
        d="M 176 344 C 128 142, 330 108, 276 232"
        fill="none" stroke={`url(#sheen-${uid})`} stroke-width="26" stroke-linecap="round"
      />
    </g>
    <!-- almofada do arco -->
    <g class="o-part" data-part="pad">
      <path
        d="M 186 296 C 156 190, 236 128, 292 138"
        fill="none" stroke="var(--cushion, #17171f)" stroke-width="13" stroke-linecap="round"
      />
    </g>
    <!-- yoke -->
    <g class="o-part" data-part="yoke">
      <path d="M 282 238 L 268 268" stroke="var(--cup-2)" stroke-width="12" stroke-linecap="round" style="transition: stroke var(--d3) var(--ease-io)" />
      <circle cx="282" cy="238" r="7" fill="var(--cup-2)" style="transition: fill var(--d3) var(--ease-io)" />
    </g>

    <!-- driver (fica atrás da concha) -->
    <g class="o-part" data-part="driver">
      <circle cx="248" cy="322" r="30" fill={`url(#driver-${uid})`} />
      <circle cx="248" cy="322" r="21" fill="#0b0b10" stroke="var(--teal)" stroke-width="1.4" />
      <circle cx="248" cy="322" r="9" fill="var(--teal)" opacity="0.85" />
      <g stroke="var(--teal)" stroke-width="1.2" opacity="0.6">
        <path d="M 248 297 v 6 M 248 341 v 6 M 223 322 h 6 M 267 322 h 6" />
      </g>
    </g>

    <!-- almofada da concha -->
    <g class="o-part" data-part="cushion">
      <ellipse cx="248" cy="322" rx="47" ry="63" fill="var(--cushion, #17171f)" />
      <ellipse cx="248" cy="322" rx="33" ry="47" fill="var(--cushion-2, #20202b)" />
    </g>

    <!-- concha externa -->
    <g class="o-part" data-part="shell">
      <ellipse cx="248" cy="322" rx="72" ry="92" fill="var(--cup)" style="transition: fill var(--d3) var(--ease-io)" />
      <ellipse cx="248" cy="322" rx="72" ry="92" fill={`url(#sheen-${uid})`} />
      <ellipse cx="216" cy="268" rx="20" ry="34" fill="#fff" opacity="0.08" transform="rotate(-16 216 268)" />
      <!-- microfones -->
      <g fill="#000" opacity="0.35">
        <circle cx="206" cy="384" r="3.4" />
        <circle cx="222" cy="394" r="3.4" />
        <circle cx="238" cy="400" r="3.4" />
      </g>
    </g>

    <!-- anel de luz (ANC) -->
    <g class="o-part" data-part="ring">
      <ellipse
        cx="248" cy="322" rx="60" ry="79"
        fill="none" stroke="var(--ring, var(--accent))" stroke-width="3"
        style="transition: stroke var(--d3) var(--ease-io); filter: drop-shadow(0 0 6px var(--glow))"
      />
      <circle cx="248" cy="243" r="4.5" fill="var(--ring, var(--accent))" style="transition: fill var(--d3) var(--ease-io)" />
    </g>
  </g>
</svg>

<style>
  .orbita-svg { overflow: visible; }
</style>
