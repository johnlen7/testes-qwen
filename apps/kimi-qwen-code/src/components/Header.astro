---
---

<header class="site-header">
  <div class="wrap site-header__in">
    <a class="brand" href="#topo" aria-label="ÓRBITA — início">
      <svg class="brand__mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
        <circle cx="16" cy="16" r="6" fill="var(--accent)" />
        <ellipse cx="16" cy="16" rx="14" ry="5.5" fill="none" stroke="currentColor" stroke-width="1.6" transform="rotate(-24 16 16)" />
      </svg>
      <span class="brand__word">ÓRBITA</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <a href="#tecnologia">Tecnologia</a>
      <a href="#configurador">Configurar</a>
      <a href="#recursos">Recursos</a>
      <a href="#faq">FAQ</a>
    </nav>

    <div class="site-header__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema claro e escuro" aria-pressed="false">
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4.4" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5 5l1.8 1.8M17.2 17.2 19 19M19 5l-1.8 1.8M6.8 17.2 5 19" />
          </g>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M20.4 14.2A8.5 8.5 0 1 1 9.8 3.6a7 7 0 1 0 10.6 10.6Z" fill="currentColor" />
        </svg>
      </button>
      <a class="btn site-header__cta" href="#configurador">Comprar</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .site-header__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    text-decoration: none;
    color: var(--ink);
  }
  .brand__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
  }
  .site-nav { display: flex; gap: var(--s5); }
  .site-nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color var(--d1) var(--ease-io);
  }
  .site-nav a:hover { color: var(--ink); }
  .site-header__actions { display: flex; align-items: center; gap: var(--s4); }
  .site-header__cta { padding: 0.55rem 1.2rem; font-size: 0.85rem; }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    color: var(--ink);
    position: relative;
    transition: border-color var(--d2), transform var(--d2) var(--ease-spring);
  }
  .theme-toggle:hover { border-color: var(--ink); transform: rotate(18deg); }
  .theme-toggle__icon {
    grid-area: 1 / 1;
    transition: opacity var(--d2) var(--ease-io), rotate var(--d3) var(--ease-expo), scale var(--d3) var(--ease-spring);
  }
  .theme-toggle__icon--moon { opacity: 0; scale: 0.4; rotate: -120deg; }
  [data-theme='light'] .theme-toggle__icon--sun { opacity: 0; scale: 0.4; rotate: 120deg; }
  [data-theme='light'] .theme-toggle__icon--moon { opacity: 1; scale: 1; rotate: 0deg; }

  @media (max-width: 768px) {
    .site-nav { display: none; }
    .site-header__cta { display: none; }
  }
</style>

<script>
  import '../scripts/theme.js';
</script>
